# 创建与AI大模型交互的客户端对象
client = OpenAI(
    api_key="sk-00329a34ae034f73955a3ce1df6f356c",
    base_url="https://api.deepseek.com"
)

#消息输入框
prompt=st.chat_input("请输入你的问题")

if prompt:
    # 显示用户消息 + 存入会话
    st.chat_message("user").write(prompt)
    print("---------->请用ai大模型，提示词",prompt)
    st.session_state.messages.append({"role": "user", "content": prompt})



    # 与AI大模型进行交互，开启流式 stream=True
    response = client.chat.completions.create(
        model="deepseek-chat",
        messages=send_msg,
        stream=True
    )

    # --------流式输出解析方式--------
    full_response = ""   # 用来拼接完整AI回答
    with st.chat_message("assistant"):
        message_placeholder = st.empty()  # 创建占位容器，不断刷新文字
        for chunk in response:
            # delta 是流式每一小块内容
            if chunk.choices[0].delta.content is not None:
                content = chunk.choices[0].delta.content
                full_response += content
                message_placeholder.write(full_response)  # 不断更新气泡文字

    # ✅保存大模型完整答案到聊天历史
    st.session_state.messages.append({"role": "assistant", "content": full_response})
    #保存会话信息
    save_session()