#加载所有的会话信息
def load_sessions():
    session_list=[]
    #加载sessions下所有的会话信息
    if os.path.exists("sessions"):
        file_list=os.listdir("sessions")#列出下面目录下的所有文件和文件夹
        for filename in file_list:
            if filename.endswith(".json"):
                session_list.append(filename[:-5])
    return session_list
#加载指定的会话信息
def load_session(session_name):
    try:
        if os.path.exists("sessions"):
            #读取会话信息
            with open(f"sessions/{session_name}.json","r",encoding="utf-8") as f:
                session_date=json.load(f)
                st.session_state.messages=session_date["messages"]
                st.session_state.nick_name=session_date["nick_name"]
                st.session_state.nature=session_date["nature"]
                st.session_state.current_session=session_name
    except Exception:
        st.error("加载会话失败")
#输出会话信息函数
def delete_session(session_name):
    try:
        if os.path.exists(f"sessions/{session_name}.json"):
            os.remove(f"sessions/{session_name}.json")
            if session_name==st.session_state.current_session:
                st.session_state.messages=[]
                st.session_state.current_session=generate_session_name()
    except Exception:
        st.error("删除会话失败")
